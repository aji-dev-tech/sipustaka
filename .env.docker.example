APP_NAME=SIPUSTAKA
APP_ENV=production
# Isi dengan hasil: echo "base64:$(openssl rand -base64 32)"  (atau pakai APP_KEY lama dari .env)
APP_KEY=
APP_DEBUG=false
# Ganti dengan IP/domain server
APP_URL=http://IP_SERVER:8089
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Koneksi internal antar container (jangan diubah ke 8010)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db_sipustaka
DB_USERNAME=sipustaka
DB_PASSWORD=GANTI_PASSWORD_APP

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Set false setelah deploy pertama dan password default diganti
RUN_SEED=true
